# Archil durable workspace for agents and sandboxed runs.
# Copy the values you need into your shell; the tools read the environment.
# Use an Archil account API key (starts with key-), never a disk token, and
# never commit a real key.
ARCHIL_API_KEY=

# Optional Archil region: aws-us-east-1, aws-us-west-2, aws-eu-west-1, or
# gcp-us-central1. Omit to use the SDK default.
ARCHIL_REGION=

# Optional disk name for tools/archil_workspace.py.
# SYNAPSE_ARCHIL_DISK=synapse-build-workspace
