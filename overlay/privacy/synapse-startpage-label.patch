+
+// Synapse distribution default: browser.newtab.url (registered by
+// app/profile/synapse.js) names a concrete start-page URL. When set, it
+// replaces the built-in Activity Stream page for about:newtab loads, so
+// new tabs, restored sessions and the homepage all open the start page;
+// about:home keeps its startup-cache handling.
+const SYNAPSE_NEW_TAB_PREF = "browser.newtab.url";
+function synapseNewTabURL() {
+  let url = Services.prefs.getStringPref(SYNAPSE_NEW_TAB_PREF, "").trim();
+  if (!url || url === "about:newtab" || url === "about:home" || url === "about:blank") {
+    return null;
+  }
+  return url;
+}
