# Generated by Synapse KryptScript. Edit config/mozconfig.in, then run `synapse-tool apply`.

# Fast first milestone: reuse compiled Gecko platform artifacts while rebuilding
# the JavaScript, CSS, Fluent, and branding layers owned by Synapse.
ac_add_options --enable-artifact-builds
ac_add_options --with-branding=browser/branding/synapse

# Never let a development Synapse build enter Mozilla's Firefox update channel.
ac_add_options --disable-updater

# Keep the application output separate from any upstream baseline build.
mk_add_options MOZ_OBJDIR=@SYNAPSE_WORKSPACE_MSYS@/.synapse-build/obj-synapse

# Keep downloaded build state and the selected make executable under this
# Synapse workspace rather than the user's global Mozilla state directory.
export MOZBUILD_STATE_PATH="@SYNAPSE_WORKSPACE_MSYS@/.synapse-build/mozbuild"
export GMAKE="@SYNAPSE_WORKSPACE_MSYS@/.synapse-build/toolchains/mozmake/mozmake.exe"
