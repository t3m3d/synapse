# Generated by Synapse KryptScript. Edit config/mozconfig.in, then run `synapse-tool apply`.

# Fast first milestone: reuse compiled Gecko platform artifacts while rebuilding
# the JavaScript, CSS, Fluent, and branding layers owned by Synapse.
ac_add_options --enable-artifact-builds
ac_add_options --with-branding=browser/branding/synapse

# Keep Gecko's local minidump handler for diagnostics. Supported Synapse
# launchers set MOZ_CRASHREPORTER_NO_REPORT so no crash UI or upload starts.
# The reserved endpoint also fails closed if Synapse is launched another way.
ac_add_options --with-crashreporter-url=https://crash.synapse.invalid

# The development browser retains Gecko's updater component so the Firefox
# application contract remains complete. Distribution policy locks application
# updates off until Synapse has a signed update service.

# Keep the application output separate from any upstream baseline build.
mk_add_options MOZ_OBJDIR=@SYNAPSE_WORKSPACE_NATIVE@/.synapse-build/obj-synapse

# Keep downloaded build state under this Synapse workspace rather than the
# user's global Mozilla state directory.
export MOZBUILD_STATE_PATH="@SYNAPSE_WORKSPACE_NATIVE@/.synapse-build/mozbuild"

# MozillaBuild uses the Synapse-managed mozmake binary. macOS uses the build
# tool selected by mach, so it must not inherit this Windows-only path.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*)
    export GMAKE="@SYNAPSE_WORKSPACE_NATIVE@/.synapse-build/toolchains/mozmake/mozmake.exe"
    ;;
esac
