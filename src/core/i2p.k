module synapse_i2p

// I2P+ exposes a combined HTTP/HTTPS proxy on this loopback endpoint by
// default. Keep these values centralized so the launcher, diagnostics, and
// contract tests cannot drift apart.
func i2pProxyHost() { emit "127.0.0.1" }
func i2pProxyPort() { emit "4444" }

func i2pProfileFolder(identityFolder) {
    emit "synapse-i2p-" + identityFolder
}

func i2pPref(name, value) {
    emit "user_pref(\"" + name + "\", " + value + ");\r\n"
}

// This file is applied at every Gecko startup. It prevents ordinary direct
// fallback and disables browser paths that could bypass an HTTP proxy. It
// cannot constrain an outproxy configured inside the I2P+ router itself.
func i2pUserPrefs() {
    let prefs = "// Generated by Synapse. Dedicated I2P+ profile.\r\n"
    prefs = prefs + "// Proxy: 127.0.0.1:4444. DIRECT fallback prefs disabled.\r\n\r\n"

    prefs = prefs + i2pPref("network.proxy.type", "1")
    prefs = prefs + i2pPref("network.proxy.http", "\"127.0.0.1\"")
    prefs = prefs + i2pPref("network.proxy.http_port", "4444")
    prefs = prefs + i2pPref("network.proxy.ssl", "\"127.0.0.1\"")
    prefs = prefs + i2pPref("network.proxy.ssl_port", "4444")
    prefs = prefs + i2pPref("network.proxy.socks", "\"\"")
    prefs = prefs + i2pPref("network.proxy.socks_port", "0")
    prefs = prefs + i2pPref("network.proxy.socks_version", "5")
    prefs = prefs + i2pPref("network.proxy.share_proxy_settings", "false")
    // I2P+ refuses router-console requests that arrive through its HTTP
    // proxy. Bypass only numeric loopback; do not exempt localhost names or
    // private/LAN ranges.
    prefs = prefs + i2pPref("network.proxy.no_proxies_on", "\"127.0.0.1\"")
    prefs = prefs + i2pPref("network.proxy.allow_hijacking_localhost", "true")
    prefs = prefs + i2pPref("network.proxy.testing_localhost_is_secure_when_hijacked", "false")
    prefs = prefs + i2pPref("network.proxy.failover_direct", "false")
    prefs = prefs + i2pPref("network.proxy.allow_bypass", "false")
    prefs = prefs + i2pPref("network.proxy.system_wpad", "false")
    prefs = prefs + i2pPref("network.proxy.system_wpad.allowed", "false")
    prefs = prefs + i2pPref("network.proxy.autoconfig_url", "\"\"")

    prefs = prefs + i2pPref("network.trr.mode", "5")
    prefs = prefs + i2pPref("network.dns.disabled", "true")
    prefs = prefs + i2pPref("network.dns.disablePrefetch", "true")
    prefs = prefs + i2pPref("network.dns.disablePrefetchFromHTTPS", "true")
    prefs = prefs + i2pPref("network.dns.prefetch_via_proxy", "false")
    prefs = prefs + i2pPref("network.prefetch-next", "false")
    prefs = prefs + i2pPref("network.http.speculative-parallel-limit", "0")
    prefs = prefs + i2pPref("network.http.http3.enable", "false")
    prefs = prefs + i2pPref("network.webtransport.enabled", "false")
    prefs = prefs + i2pPref("network.webtransport.redirect.enabled", "false")
    prefs = prefs + i2pPref("network.connectivity-service.enabled", "false")
    prefs = prefs + i2pPref("network.captive-portal-service.enabled", "false")
    prefs = prefs + i2pPref("browser.urlbar.speculativeConnect.enabled", "false")
    prefs = prefs + i2pPref("browser.places.speculativeConnect.enabled", "false")

    prefs = prefs + i2pPref("media.peerconnection.enabled", "false")
    prefs = prefs + i2pPref("media.peerconnection.ice.proxy_only", "true")
    prefs = prefs + i2pPref("media.navigator.enabled", "false")
    prefs = prefs + i2pPref("geo.enabled", "false")

    prefs = prefs + i2pPref("network.protocol-handler.external-default", "false")
    prefs = prefs + i2pPref("network.protocol-handler.warn-external-default", "true")
    prefs = prefs + i2pPref("network.protocol-handler.external.mailto", "false")

    // Most I2P sites use HTTP. Prevent Gecko from turning an I2P hostname into
    // a clearnet search or an HTTPS-only upgrade.
    prefs = prefs + i2pPref("dom.security.https_only_mode", "false")
    prefs = prefs + i2pPref("dom.security.https_only_mode_pbm", "false")
    prefs = prefs + i2pPref("keyword.enabled", "false")
    prefs = prefs + i2pPref("browser.fixup.domainsuffixwhitelist.i2p", "true")
    prefs = prefs + i2pPref("browser.fixup.alternate.enabled", "false")
    prefs = prefs + i2pPref("browser.search.suggest.enabled", "false")
    prefs = prefs + i2pPref("browser.urlbar.suggest.searches", "false")
    prefs = prefs + i2pPref("browser.startup.homepage", "\"about:blank\"")
    prefs = prefs + i2pPref("browser.newtabpage.enabled", "false")

    prefs = prefs + i2pPref("privacy.resistFingerprinting", "true")
    prefs = prefs + i2pPref("privacy.resistFingerprinting.letterboxing", "true")
    prefs = prefs + i2pPref("xpinstall.enabled", "false")
    prefs = prefs + i2pPref("extensions.getAddons.showPane", "false")
    prefs = prefs + i2pPref("extensions.htmlaboutaddons.recommendations.enabled", "false")
    emit prefs
}
