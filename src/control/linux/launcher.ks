// Linux Wayland launcher using Choc and the KryptOS Objective-K runtime.
import "k:choc_linux"
// The current ELF frontend needs these SmackUI imports directly.
import "k:smack/geometry"
import "k:smack/view"
import "../../core/i2p.k"

objk object SynapseLinuxLauncher {
    method message() -> text = launcherMessage
}

let launcher = 0
let launcherRuntime = 0
let window = ""
let browserPath = ""
let launcherQuit = 0
let launcherMsgDirty = 0

func launcherMessage(runtime, self) {
    emit okKGet(runtime, self, "message")
}

func setMessage(message) {
    let text = okKText(launcherRuntime, message)
    doKText(launcherRuntime, launcher, "message", text)
    doKReleaseText(launcherRuntime, text)
}

func shellQuote(value) {
    emit "'" + replace(value, "'", "'\\''") + "'"
}

func renderLauncher() {
    chocClear(window, colorRGB(27, 27, 27))
    chocDrawText(window, 26, 42, "Synapse", chocColor(246, 248, 252))
    chocDrawText(window, 26, 92, "Enter   Open Synapse", chocColor(191, 210, 247))
    chocDrawText(window, 26, 120, "I       Open isolated I2P+ profile", chocColor(191, 210, 247))
    chocDrawText(window, 26, 148, "Esc     Close launcher", chocColor(191, 210, 247))
    let text = okKSend(launcherRuntime, launcher, "message")
    chocDrawText(window, 26, 200, okKTextValue(launcherRuntime, text), chocColor(246, 248, 252))
}

func startBrowser(args) {
    let cmd = "MOZ_CRASHREPORTER_NO_REPORT=1 " + shellQuote(browserPath) +
        args + " </dev/null &"
    emit shellRun(cmd) == "0"
}

func i2pProfilePath() {
    let data = environ("XDG_DATA_HOME")
    if startsWith(data, "/") != 1 {
        let userHome = environ("HOME")
        if startsWith(userHome, "/") != 1 { emit "" }
        data = userHome + "/.local/share"
    }
    emit data + "/synapse/profiles/" + i2pProfileFolder("personal")
}

func i2pPrepareProfile(profile) {
    if profile == "" { emit 0 }
    let dir = shellQuote(profile)
    if shellRun("umask 077 && mkdir -p -- " + dir + " && chmod 700 -- " + dir) != "0" { emit 0 }
    let prefs = profile + "/user.js"
    let target = shellQuote(prefs)
    if shellRun("test -L " + target) == "0" { emit 0 }
    if shellRun("test -e " + target) == "0" {
        if shellRun("test -f " + target) != "0" { emit 0 }
        if startsWith(readFile(prefs), "// Generated by Synapse. Dedicated I2P+ profile.") != 1 { emit 0 }
    }
    let staged = getLine(exec("mktemp -- " + shellQuote(profile + "/.user.js.XXXXXXXX")), 0)
    if startsWith(staged, profile + "/.user.js.") != 1 { emit 0 }
    let prefsText = i2pUserPrefs()
    writeFile(staged, prefsText)
    if readFile(staged) != prefsText || shellRun("mv -fT -- " + shellQuote(staged) + " " + target) != "0" {
        shellRun("rm -f -- " + shellQuote(staged))
        emit 0
    }
    emit 1
}

func requestI2p() {
    // A listening TCP port does not authenticate the proxy or prove bootstrap.
    let fd = sockMake()
    if fd < 0 { emit "Could not check the local I2P+ proxy." }
    let port = toInt(i2pProxyPort())
    let high = port / 256
    let connected = sockConnect(fd, 127, 0, 0, 1, high, port - high * 256)
    sockClose(fd)
    if connected != 0 { emit "Start I2P+ first. The local proxy is unavailable." }
    let profile = i2pProfilePath()
    if i2pPrepareProfile(profile) != 1 { emit "Could not prepare the I2P+ profile." }
    if !startBrowser(" --no-remote --profile " + shellQuote(profile) + " " + shellQuote(i2pStartUrl("home"))) {
        emit "Could not request the I2P+ browser launch."
    }
    emit ""
}

func onLauncherKey(key, modifiers) {
    if key == 1 {
        launcherQuit = 1
        emit 1
    }
    if key == 28 {
        if startBrowser("") { setMessage("Synapse launch requested.") }
        else { setMessage("Could not request the browser launch.") }
    } else if key == 23 {
        let error = requestI2p()
        if error == "" { setMessage("I2P+ browser launch requested.") }
        else { setMessage(error) }
    } else {
        emit 0
    }
    renderLauncher()
    launcherMsgDirty = 1
    emit 1
}

just run {
    if argCount() < 1 || argCount() > 2 {
        print("Usage: synapse-launcher /absolute/path/to/synapse [--i2p]")
        exit(2)
    }
    browserPath = arg(0)
    if startsWith(browserPath, "/") != 1 || shellRun("test -f " + shellQuote(browserPath) +
        " && test -x " + shellQuote(browserPath)) != "0" {
        print("Select an executable Synapse browser using its absolute path.")
        exit(2)
    }
    if argCount() == 2 {
        if arg(1) != "--i2p" { exit(2) }
        let error = requestI2p()
        if error != "" { print(error); exit(1) }
        print("I2P+ browser launch requested.")
        exit(0)
    }
    // The Linux ELF backend keeps the implicit runtime local to the entry
    // block. Keep an explicit reference for the Choc callbacks.
    launcherRuntime = __objkRuntime
    launcher = okKNew(launcherRuntime, SynapseLinuxLauncher)
    setMessage("I2P+ requires a running local router.")
    // The app owns the loop: pump events, present when the callback dirtied
    // the frame. (chocRun was removed — a shared quit flag cannot cross an
    // import boundary; setField copies structs, it does not mutate in place.)
    window = chocWindow(chocSharedApp(), "Synapse", 580, 240)
    window = chocOnKey(window, funcptr(onLauncherKey))
    renderLauncher()
    while launcherQuit == 0 {
        window = chocPumpEvents(window)
        if launcherMsgDirty == 1 {
            window = chocPresent(window)
            launcherMsgDirty = 0
        }
    }
    doKRelease(launcherRuntime, launcher)
}
